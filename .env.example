# DoomSat configuration. Copy to .env (git-ignored) and fill in:  cp .env.example .env
# Every script and the pilot read this one file.

# --- Models ------------------------------------------------------------------------------------------
# System One, jev (required for the pilot): a TypeSafe API key from https://docs.typesafe.ai
TYPESAFE_API_KEY=

# System Two, Claude: nothing to set. The pilot calls the `claude` CLI (Claude Code), which uses your
# own Claude Code login. Only if you run with --system-two anthropic does it need an API key:
# ANTHROPIC_API_KEY=

# Optional: any OpenAI-compatible endpoint instead (--system-one openai / --system-two openai)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:1234/v1

# Optional: local models on one Jetson (docs/JETSON-RUNBOOK.md). Each role has its own endpoint, so System One
# and System Two can be different llama.cpp servers. The flags --system-one-base-url / --system-two-base-url
# win over these, and these win over OPENAI_BASE_URL.
# System One = Rune (--system-one rune): the llama.cpp server root; a trailing /v1 is accepted too
# RUNE_BASE_URL=http://127.0.0.1:8080
# RUNE_TEMPERATURE=2        # calibration temperature for the option probabilities (Rune's is 2)
# RUNE_TIMEOUT_S=1.2        # the whole System One call, all questions of a tick; jev's ceiling is 1.2
# System Two = a local Gemma 4 (--system-two openai --system-two-model gemma-4-31b): the OpenAI-style /v1 URL
# SYSTEM_TWO_BASE_URL=http://127.0.0.1:8081/v1

# --- Where the flight side is installed --------------------------------------------------------------
# F´ project, ViZDoom venv, WADs and run logs. Default ~/doom (a Linux/WSL path, not a Windows one).
# DOOMSAT_HOME=/home/you/doom

# --- Windows only: the WSL distro the flight side runs in, when you drive it from Git Bash -----------
# Not needed if you work inside the WSL shell itself.
# DOOMSAT_WSL_DISTRO=Ubuntu
# DOOMSAT_WSL_USER=
