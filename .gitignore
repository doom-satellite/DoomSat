.env
out/
external/
*.pyc
__pycache__/
.venv/
node_modules/

# Research runs (charter 6.1). `out/` above would swallow research/out entirely; keep the graded results,
# the summaries and the preflight record -- those are the run details worth having in the repo -- and drop
# the raw per-decision attempt files, which are megabytes each and reproducible from the same commit.
!research/out/
research/out/**/attempt-*.json
research/out/**/RUN.lock

# ViZDoom drops a config file wherever it is started from
_vizdoom.ini
_vizdoom/

# Pinned experiment worktrees: scratch checkouts of a commit, created by research/pinned.py
research/worktrees/

# Open MCT replay packs and the displays built for them: rebuilt from research/out by
# tools/build_openmct_replay.py, so never committed twice. A campaign build (--plan-start) is one flight's.
ground/openmct/replay/
ground/openmct/displays/*.replay.json
ground/openmct/displays/*.campaign.json
# What npm writes beside node_modules/ when the README's replay step installs Open MCT into ground/openmct
ground/openmct/package.json
ground/openmct/package-lock.json
